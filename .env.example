# คัดลอกเป็น .env แล้วใส่ค่าจริงของเครื่องตัวเอง — ห้าม commit .env
# Ports ฝั่งเครื่อง (host)
API_PORT=3000
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379
S3_HOST_PORT=8333
CLAMD_HOST_PORT=3310

# PostgreSQL — owner ใช้รัน migration, app ใช้ตอนรันระบบ (สร้างใน migration)
POSTGRES_DB=sdes
POSTGRES_OWNER_USER=sdes_owner
POSTGRES_OWNER_PASSWORD=change-me
POSTGRES_APP_PASSWORD=change-me

# Redis
REDIS_PASSWORD=change-me

# S3-compatible storage (SeaweedFS ใน dev, S3 ของ cloud ใน production)
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=sdes-documents
S3_REGION=ap-southeast-1
# บังคับ true ใน production
S3_SSE=false

# Seed System Admin คนแรก (รหัสผ่านชั่วคราว ต้องเปลี่ยนตอนล็อกอินครั้งแรก)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
# บริษัทผู้ซื้อในใบกำกับภาษี (ใช้ตรวจ Tax ID ผู้ซื้อ) — แก้ภายหลังได้ที่หน้าตั้งค่า
COMPANY_TAX_ID=
COMPANY_NAME=

# กุญแจเข้ารหัส API key/secret ของการเชื่อมต่อ ERP (AES-256-GCM) — หายแล้วต้องใส่ API key ใหม่ในหน้าตั้งค่า ERP
ERP_SECRET_KEY=change-me

# ลายเซ็น access token (สุ่มอย่างน้อย 32 bytes)
JWT_SECRET=change-me
# true ใน production (cookie Secure)
COOKIE_SECURE=false

# การอ่านเอกสาร (worker): fake = ผลว่าง, fixture = เฉลยของชุดทดสอบ, claude / gemini = AI จริง (มีค่าใช้จ่าย)
EXTRACTION_PROVIDER=fake
# ต้องมีเมื่อใช้ claude — ใช้บัญชี API เชิงพาณิชย์ที่ไม่นำข้อมูลไปฝึกโมเดล
ANTHROPIC_API_KEY=
# ต้องมีเมื่อใช้ gemini — ต้องเป็น paid tier (free tier นำข้อมูลไปปรับปรุงผลิตภัณฑ์และอาจมีคนอ่าน)
GEMINI_API_KEY=
# ว่าง = รุ่นเริ่มต้นของ provider: claude-opus-5-5 / gemini-3.8-flash
EXTRACTION_MODEL=
# เฉพาะ claude: low | medium | high | xhigh | max
EXTRACTION_EFFORT=low
EXTRACTION_TIMEOUT_MS=120000
# โฟลเดอร์เฉลย <sha256>.json ของ fixture provider (บนเครื่อง; ใน container mount ไว้ที่ /fixtures)
EXTRACTION_FIXTURE_HOST_DIR=./.fixtures
