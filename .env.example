# คัดลอกเป็น .env แล้วใส่ค่าจริงของเครื่องตัวเอง — ห้าม commit .env
# Ports ฝั่งเครื่อง (host)
API_PORT=3000
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379
S3_HOST_PORT=8333
CLAMD_HOST_PORT=3310

# PostgreSQL — owner ใช้รัน migration, app ใช้ตอนรันระบบ (สร้างใน migration)
POSTGRES_DB=sdes
POSTGRES_OWNER_USER=sdes_owner
POSTGRES_OWNER_PASSWORD=change-me
POSTGRES_APP_PASSWORD=change-me

# Redis
REDIS_PASSWORD=change-me

# S3-compatible storage (SeaweedFS ใน dev, S3 ของ cloud ใน production)
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=sdes-documents
S3_REGION=ap-southeast-1
# บังคับ true ใน production
S3_SSE=false

# Seed System Admin คนแรก (รหัสผ่านชั่วคราว ต้องเปลี่ยนตอนล็อกอินครั้งแรก)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
