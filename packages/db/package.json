{
  "name": "@sdes/db",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/generated','dist/generated',{recursive:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "prisma": "node scripts/prisma.mjs",
    "generate": "node scripts/prisma.mjs generate",
    "migrate:dev": "node scripts/prisma.mjs migrate dev",
    "migrate:deploy": "node scripts/prisma.mjs migrate deploy",
    "seed": "node dist/seed-cli.js",
    "postinstall": "node scripts/prisma.mjs generate"
  },
  "devDependencies": {
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.20",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "prisma": "^6.19.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@prisma/client": "^6.19.3",
    "@sdes/core": "workspace:*",
    "argon2": "^0.45.1"
  }
}
